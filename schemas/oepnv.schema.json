{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/fcou1005/mobility-pulse/schemas/oepnv.schema.json",
 "title": "ÖPNV – Halte je Station, geschätzte Fahrzeugwege, Wirkung auf Sharing (Reiter ÖPNV)",
 "description": "oepnv/<AGS>.json (Stationen und Stunden einer Gemeinde), oepnv/live/<AGS>.json (geschätzte Fahrzeugwege der nächsten Minuten), oepnv/wirkung.json und oepnv/index.json. Quelle: GTFS-Realtime von gtfs.de (CC BY-SA 4.0), Haltestellen CC BY 4.0. Fahrzeugwege sind aus Haltezeiten geschätzt, keine Ortung. Keine Fahrzeugkennungen, keine Fahrgastzahlen.",
 "x-version": "1.8",
 "$defs": {
  "ags": {
   "type": "object",
   "description": "Stationen einer Gemeinde mit Flotte (höchstens 300, nach Halten) und Halte je Stunde der letzten 8 Tage; je Lauf neu",
   "required": [
    "schemaVersion",
    "ags",
    "at",
    "fields",
    "rows",
    "hours"
   ],
   "properties": {
    "schemaVersion": {
     "type": "string",
     "pattern": "^1\\.\\d+$",
     "description": "Formatversion MAJOR.MINOR"
    },
    "ags": {
     "type": "string",
     "pattern": "^\\d{8}$"
    },
    "at": {
     "type": "number",
     "description": "Zeit des Laufs (ms)"
    },
    "feedAt": {
     "type": [
      "number",
      "null"
     ],
     "description": "Zeit des Echtzeit-Stroms (ms)"
    },
    "license": {
     "type": "string"
    },
    "attribution": {
     "type": "string"
    },
    "halfLifeDays": {
     "type": "number",
     "description": "Halbwertszeit der Summen in Tagen"
    },
    "days": {
     "type": "number",
     "description": "Tage in der Summe (mit Halbwertszeit gewichtet); Halte je Tag = halte ÷ days"
    },
    "stations": {
     "type": "integer",
     "description": "Stationen der Gemeinde im Fahrplan"
    },
    "fields": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Spalten von rows: station, name, lat, lon, halte, ausgefallen, verspaetet (ab 5 Minuten), verspaetung_min (Mittel der Halte mit Angabe), halte_heute, ausgefallen_heute, verspaetet_heute"
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11
     }
    },
    "hours": {
     "type": "object",
     "description": "je Tag 24 Ortsstunden: Halte mit Echtzeit, ausgefallen, verspätet, Kennzeichen gestört; cancel = ganz ausgefallene Fahrten des Tages",
     "required": [
      "days",
      "n",
      "skip",
      "late"
     ],
     "properties": {
      "days": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "n": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 24,
        "maxItems": 24,
        "items": {
         "type": "number"
        }
       }
      },
      "skip": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 24,
        "maxItems": 24,
        "items": {
         "type": "number"
        }
       }
      },
      "late": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 24,
        "maxItems": 24,
        "items": {
         "type": "number"
        }
       }
      },
      "flag": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 24,
        "maxItems": 24,
        "items": {
         "type": "number"
        }
       }
      },
      "cancel": {
       "type": "array",
       "items": {
        "type": "number"
       }
      }
     }
    },
    "lines": {
     "type": "object",
     "description": "Linien der Gemeinde (höchstens 80, nach Halten), Summe wie rows; seit 1.1",
     "required": [
      "fields",
      "rows"
     ],
     "properties": {
      "fields": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Spalten von rows: linie, art ('bus' | 'tram' | 'ubahn' | 'sbahn' | 'regio' | 'fern' | 'sonst'; bis 1.1 'bahn' für alle Bahnen), halte, ausgefallen, verspaetet (ab 5 Minuten), verspaetung_min, halte_heute, ausgefallen_heute, verspaetet_heute"
      },
      "rows": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 9,
        "maxItems": 9
       }
      }
     }
    },
    "profile": {
     "type": [
      "object",
      "null"
     ],
     "description": "Tagesgang je Ortsstunde, Mittel der Tage vor heute: ÖPNV-Halte mit Echtzeit gegen Sharing-Fahrtbeginne; gap = Stunden mit ÖPNV unter gapShare des Höchstwerts und mindestens minSharing Fahrtbeginnen; seit 1.1",
     "properties": {
      "days": {
       "type": "integer"
      },
      "pt": {
       "type": "array",
       "minItems": 24,
       "maxItems": 24,
       "items": {
        "type": "number"
       }
      },
      "sharing": {
       "type": "array",
       "minItems": 24,
       "maxItems": 24,
       "items": {
        "type": "number"
       }
      },
      "gap": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      },
      "gapShare": {
       "type": "number"
      },
      "minSharing": {
       "type": "number"
      }
     }
    },
    "jetzt": {
     "type": "object",
     "description": "Stationen, die in den letzten windowH Stunden gestört waren (ab minN Halten, mindestens 30 % ausgefallen oder verspätet oder 15 % ausgefallen); seit 1.3",
     "required": [
      "windowH",
      "fields",
      "rows"
     ],
     "properties": {
      "windowH": {
       "type": "number"
      },
      "minN": {
       "type": "number"
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Spalten von rows: station, name, lat, lon, halte, ausgefallen, verspaetet (ab 5 Minuten)"
      },
      "rows": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7
       }
      }
     }
    },
    "gebiet": {
     "type": [
      "object",
      "null"
     ],
     "description": "Seit 1.8 (19.11.2026): Geschäftsgebiet der Sharing-Anbieter – Zellen (≈ 280 × 250 m), in denen in den letzten days Tagen ein verfügbares Fahrzeug stand, plus ring Zellen Rand. outside = Station-IDs der Gemeinde außerhalb (sichtbar, aber kein Bedarf an Sharing-Fahrzeugen: Jetzt gestört, Stationsvorschläge, Disposition), names = bis zu 12 davon mit den meisten Halten. null bei unter 10 bedienten Zellen (dann zählt jede Station).",
     "required": [
      "days",
      "cells",
      "ring",
      "inside",
      "outside",
      "names"
     ],
     "properties": {
      "days": { "type": "integer", "minimum": 0 },
      "cells": { "type": "integer", "minimum": 0 },
      "ring": { "type": "integer", "minimum": 0 },
      "inside": { "type": "integer", "minimum": 0 },
      "outside": { "type": "array", "items": { "type": "string" } },
      "names": { "type": "array", "items": { "type": "string" }, "maxItems": 12 }
     }
    },
    "prognose": {
     "type": [
      "object",
      "null"
     ],
     "description": "Seit 1.7 (F28): Verspätungsprognose der Gemeinde (lib/pulse-oepnv-prog.js). next: [Tag, Ortsstunde, Anteil verspätet ≥ 5 Min., Anteil ausgefallen, Halte erwartet] für die nächsten 24 Stunden; eval: Selbstprüfung der letzten Tage (mae, maeNaive = „wie gestern“, als Anteil, days, hours, better); mean: Mittel der Tage vor heute; lines: [Linie, Art, erwartet verspätet, erwartet ausgefallen] für die nächsten 3 Stunden.",
     "properties": {
      "at": {
       "type": "number"
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "next": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       }
      },
      "eval": {
       "type": [
        "object",
        "null"
       ]
      },
      "mean": {
       "type": "object"
      },
      "lines": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4
       }
      }
     }
    }
   }
  },
  "live": {
   "type": "object",
   "description": "Geschätzte Fahrzeugwege ab at für aheadMin Minuten; je Lauf neu",
   "required": [
    "schemaVersion",
    "ags",
    "at",
    "aheadMin",
    "fields",
    "trips"
   ],
   "properties": {
    "schemaVersion": {
     "type": "string",
     "pattern": "^1\\.\\d+$",
     "description": "Formatversion MAJOR.MINOR"
    },
    "ags": {
     "type": "string",
     "pattern": "^\\d{8}$"
    },
    "at": {
     "type": "number"
    },
    "feedAt": {
     "type": [
      "number",
      "null"
     ]
    },
    "aheadMin": {
     "type": "number"
    },
    "license": {
     "type": "string"
    },
    "attribution": {
     "type": "string"
    },
    "fields": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Spalten von trips: linie (oder null), art ('bus' | 'tram' | 'ubahn' | 'sbahn' | 'regio' | 'fern' | 'sonst'; bis 1.1 'bahn' für alle Bahnen), verspaetung_s am nächsten Halt (oder null), weg = [lat, lon, Sekunden nach at, …] je Station; seit 1.5 ausgefallene_halte = [lat, lon, …] der ausgefallenen Halte zwischen erstem und letztem Punkt des Wegs (nur wenn welche); seit 1.6 ziel (Fahrtziel aus trip_headsign, sonst letzter Halt im Strom, oder null) und halte (je Punkt des Wegs der Index in names)"
    },
    "trips": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 7
     }
    },
    "ausfall": {
     "type": [
      "object",
      "null"
     ],
     "description": "Seit 1.5: ganz ausgefallene Fahrten laut Echtzeit-Strom. rows = [linie, art, weg] für Fahrten mit Zeit im Fenster (30 Minuten zurück bis aheadMin voraus); lines = [linie, art, fahrten, ohne_zeit] je Linie über alle abgesagten Fahrten im Strom (ohne_zeit: nur Fahrt und Betriebstag bekannt); seit 1.6 rows mit ziel als viertem Feld",
     "properties": {
      "fields": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rows": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4
       }
      },
      "lineFields": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "lines": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4
       }
      }
     }
    },
    "names": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Seit 1.6: Namen der Stationen, auf die halte in trips zeigt"
    }
   }
  },
  "wirkung": {
   "type": "object",
   "description": "Sharing-Fahrtbeginne in gestörten Stunden gegen die übrigen Stunden derselben Gemeinde",
   "required": [
    "schemaVersion",
    "at",
    "cities"
   ],
   "properties": {
    "schemaVersion": {
     "type": "string",
     "pattern": "^1\\.\\d+$",
     "description": "Formatversion MAJOR.MINOR"
    },
    "at": {
     "type": "number"
    },
    "days": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "rule": {
     "type": [
      "string",
      "null"
     ]
    },
    "pooled": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "effect": {
       "type": "number"
      },
      "ci": {
       "type": "array",
       "items": {
        "type": "number"
       }
      },
      "cityDays": {
       "type": "integer"
      },
      "hours": {
       "type": "integer"
      },
      "cities": {
       "type": "integer"
      },
      "verdict": {
       "type": "string"
      }
     }
    },
    "cities": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "ags",
       "days",
       "hours",
       "effect",
       "verdict"
      ],
      "properties": {
       "ags": {
        "type": "string",
        "pattern": "^\\d{8}$"
       },
       "days": {
        "type": "integer"
       },
       "hours": {
        "type": "integer"
       },
       "normalHours": {
        "type": "integer"
       },
       "effect": {
        "type": "number"
       },
       "ci": {
        "type": "array",
        "items": {
         "type": "number"
        }
       },
       "verdict": {
        "type": "string"
       }
      }
     }
    },
    "learn": {
     "type": "object",
     "description": "Passiv gelernte Wirkung je Stadt (seit 1.4): Tageswerte bis 60 Tage zurück, je Stadt mit k Tagen zur Gesamtwirkung gezogen; since = Beginn des Lernens, until = frühestens einschalten",
     "properties": {
      "since": {
       "type": [
        "string",
        "null"
       ]
      },
      "until": {
       "type": [
        "string",
        "null"
       ]
      },
      "k": {
       "type": "number"
      },
      "pooled": {
       "type": "object",
       "properties": {
        "effect": {
         "type": "number"
        },
        "cityDays": {
         "type": "integer"
        }
       }
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "cities": {
       "type": "object",
       "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3
       }
      }
     }
    }
   }
  },
  "index": {
   "type": "object",
   "description": "Übersicht je Gemeinde",
   "required": [
    "schemaVersion",
    "at",
    "fields",
    "cities"
   ],
   "properties": {
    "schemaVersion": {
     "type": "string",
     "pattern": "^1\\.\\d+$",
     "description": "Formatversion MAJOR.MINOR"
    },
    "at": {
     "type": "number"
    },
    "feedAt": {
     "type": [
      "number",
      "null"
     ]
    },
    "license": {
     "type": "string"
    },
    "attribution": {
     "type": "string"
    },
    "aheadMin": {
     "type": "number"
    },
    "days": {
     "type": "number"
    },
    "trips": {
     "type": "integer",
     "description": "Fahrzeugwege im Lauf"
    },
    "withRoute": {
     "type": "integer",
     "description": "davon mit Linie"
    },
    "fields": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cities": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
       "type": "number"
      }
     }
    }
   }
  }
 }
}
