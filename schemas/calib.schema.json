{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/fcou1005/mobility-pulse/schemas/calib.schema.json",
 "title": "calib.json – Kalibrierung",
 "description": "Vorgerechnete Kalibrierung (Faktor k je Gemeinde, Prüfwerte, Strukturbrüche) für Bericht und Prognose.",
 "x-version": "1.0",
 "type": "object",
 "required": [
  "schemaVersion",
  "at",
  "days",
  "own"
 ],
 "properties": {
  "schemaVersion": {
   "type": "string",
   "pattern": "^1\\.\\d+$",
   "description": "Formatversion MAJOR.MINOR; MAJOR steigt bei unverträglichen Änderungen, MINOR bei neuen Feldern"
  },
  "version": {
   "type": "integer"
  },
  "at": {
   "type": "integer",
   "minimum": 1500000000000.0,
   "maximum": 4100000000000.0
  },
  "latestAt": {
   "anyOf": [
    {
     "type": "integer",
     "minimum": 1500000000000.0,
     "maximum": 4100000000000.0
    },
    {
     "type": "null"
    }
   ]
  },
  "days": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  },
  "breaks": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  },
  "kinds": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "own": {
   "type": "object"
  },
  "langs": {
   "type": "object"
  }
 }
}
