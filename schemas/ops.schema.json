{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/fcou1005/mobility-pulse/schemas/ops.schema.json",
 "title": "ops/<Land>.json – Bestand für die Disposition",
 "description": "Je sichtbarem Fahrzeug eine Zeile ohne Kennung (Felder in vehicleFields), Stationen in stationFields; Anbieter und Gemeinden als Index in ops und munis.",
 "x-version": "1.0",
 "type": "object",
 "required": [
  "schemaVersion",
  "at",
  "state",
  "types",
  "vehicleFields",
  "stationFields",
  "ops",
  "munis",
  "vehicles",
  "stations"
 ],
 "properties": {
  "schemaVersion": {
   "type": "string",
   "pattern": "^1\\.\\d+$",
   "description": "Formatversion MAJOR.MINOR; MAJOR steigt bei unverträglichen Änderungen, MINOR bei neuen Feldern"
  },
  "at": {
   "type": "integer",
   "minimum": 1500000000000.0,
   "maximum": 4100000000000.0
  },
  "state": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "types": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "trackStart": {
   "anyOf": [
    {
     "type": "integer",
     "minimum": 1500000000000.0,
     "maximum": 4100000000000.0
    },
    {
     "type": "null"
    }
   ]
  },
  "vehicleFields": {
   "type": "string"
  },
  "stationFields": {
   "type": "string"
  },
  "ops": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "munis": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{8}$"
   }
  },
  "vehicles": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 4,
    "items": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "stations": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 4
   }
  }
 }
}
