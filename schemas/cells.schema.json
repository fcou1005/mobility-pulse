{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/fcou1005/mobility-pulse/schemas/cells.schema.json",
 "title": "cells/<Tag>/<Land>.json – Zellen je Tageszeit-Band",
 "description": "Je Gemeinde und Rasterzelle Summen je Band; Zellen mit weniger als minCount Ereignissen sind unterdrückt (Summen in below).",
 "x-version": "1.1",
 "type": "object",
 "required": [
  "schemaVersion",
  "day",
  "state",
  "fields",
  "munis",
  "minCount"
 ],
 "properties": {
  "schemaVersion": {
   "type": "string",
   "pattern": "^1\\.\\d+$",
   "description": "Formatversion MAJOR.MINOR; MAJOR steigt bei unverträglichen Änderungen, MINOR bei neuen Feldern"
  },
  "day": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "state": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "bandMin": {
   "type": "array"
  },
  "bandRuns": {
   "type": "array"
  },
  "fields": {
   "type": "string",
   "description": "Felder je Zelle: start,end,present,reloc,start×6,present×6,end×6; seit 1.1 (S6.3, 14.11.2026) dazu angebot×6 = Läufe mit mindestens einem verfügbaren Fahrzeug je Band (ältere Tage ohne diese Felder)"
  },
  "munis": {
   "type": "object",
   "propertyNames": {
    "type": "string",
    "pattern": "^\\d{8}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "array",
     "items": {
      "type": "number"
     }
    }
   }
  },
  "below": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "number"
    }
   }
  },
  "minCount": {
   "type": "integer"
  },
  "suppress": {
   "type": "integer"
  },
  "published": {
   "type": "object",
   "required": [
    "at",
    "complete"
   ],
   "properties": {
    "at": {
     "type": "integer",
     "minimum": 1500000000000.0,
     "maximum": 4100000000000.0
    },
    "through": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1500000000000.0,
       "maximum": 4100000000000.0
      },
      {
       "type": "null"
      }
     ]
    },
    "complete": {
     "type": "boolean"
    }
   },
   "description": "Veröffentlichungsstand; fehlt in Dateien vor dem 2. November 2026"
  }
 }
}
