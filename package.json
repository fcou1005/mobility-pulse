{
  "name": "mobility-pulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobility Pulse – Sharing-Datensammler (GBFS/MobiData BW/MOBIDROM NRW/CityBikes) und Dashboard für Deutschland",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "boundaries": "node scripts/prepare-boundaries.mjs",
    "collect": "node scripts/collect.mjs",
    "test": "node test/run.mjs",
    "web": "node scripts/build-web.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:unit": "node scripts/test-all.mjs --unit",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "node test/browser.mjs",
    "fixture": "node scripts/make-fixture.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  },
  "//": "Der Sammler (scripts/collect.mjs) läuft ohne Abhängigkeiten; devDependencies nur für Build, Typprüfung und Tests."
}
